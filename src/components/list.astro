---
// Ours
import { type Translations } from "@/i18n";


interface Props {
  heading: string;
  list: Translations["resources"]["section"]["materials" | "legal"]["list"];
}

const { heading, list } = Astro.props;
---


<section>
  <h3 class="mt-20 text-2xl font-bold trim">{heading}</h3>
  <ul class="mt-8">

    {list.map(item => (
      <li>
        <a
          class="
            block h-11 underline
            hover:text-purple-500
          "
          href={item.link}
          >
            {item.name}
          </a>
      </li>
    ))}

  </ul>
</section>
