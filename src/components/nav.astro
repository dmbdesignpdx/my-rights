---
// Theirs
import { getRelativeLocaleUrl } from "astro:i18n";

// Ours
import { type Link } from "@/types/main.d";
import { type LanguageCode, LANGUAGES } from "@/constants/lang";
import { Select } from "@/components/select";
import { SiteDrawer } from "@/components/drawer";


interface Props {
  links: Link[]
}

const { links } = Astro.props;
const locale = Astro.currentLocale as LanguageCode;

const options = LANGUAGES.map(lang => ({
  id: lang,
  value: getRelativeLocaleUrl(lang, "/"),
}));
---

<nav
  data-label="Page Navigation"
  class="fixed top-0 z-10 w-full border-b border-border bg-background"
>
  <div class="wrap flex h-14 items-center justify-between">
    <SiteDrawer
      locale={locale}
      links={links}
      client:idle
    />
    <Select
      locale={locale}
      options={options}
      client:visible
    />
  </div>
</nav>
