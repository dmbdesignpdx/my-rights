---
import { Select } from "@/components/select";
import { SiteDrawer } from "@/components/drawer";
import { getRelativeLocaleUrl } from "astro:i18n";


interface Props {
  locale: string;
  links: { label: string, href: string, id: string }[]
}

const { locale, links } = Astro.props;

const options = [
  { id: "en", label: "EN", value: getRelativeLocaleUrl("en", "/") },
  { id: "es", label: "ES", value: getRelativeLocaleUrl("es", "/") },
];
---

<nav 
  class="w-full py-1 fixed top-0 z-10 bg-background border-b border-zinc-200 dark:border-zinc-700"
>
  <div class="wrap flex justify-between items-center">
    <SiteDrawer links={links} client:load />
    <Select
      locale={locale}
      options={options}
      client:load
    />
  </div>
</nav>
