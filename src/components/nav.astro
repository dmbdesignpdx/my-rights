---
// Theirs
import { getRelativeLocaleUrl } from "astro:i18n";

// Ours
import { type Language } from "@/constants/lang";
import { Select } from "@/components/select";
import { SiteDrawer } from "@/components/drawer";


interface Props {
  locale: Language;
  links: { label: string, href: string, id: string }[]
}

const { locale, links } = Astro.props;

const options = [
  { id: "en", label: "EN", value: getRelativeLocaleUrl("en", "/") },
  { id: "es", label: "ES", value: getRelativeLocaleUrl("es", "/") },
];
---

<nav
  class="fixed top-0 z-10 w-full border-b border-border bg-background"
>
  <div class="wrap flex h-14 items-center justify-between">
    <SiteDrawer
      locale={locale}
      links={links}
      client:idle
    />
    <Select
      locale={locale}
      options={options}
      client:visible
    />
  </div>
</nav>
