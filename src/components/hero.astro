---
export interface Props {
  heading: string;
  subheading: string;
}

const { heading, subheading } = Astro.props;
---

<header class="h-[50vh] flex items-center justify-start">
  <hgroup class="wrap">
    <h1 class="text-4xl md:text-5xl font-bold">{heading}</h1>
    <p class="highlight text-4xl md:text-5xl font-bold">{subheading}</p>
  </hgroup>
</header>
