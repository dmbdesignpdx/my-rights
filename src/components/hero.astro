---
export interface Props {
  heading: string;
  subheading: string;
}

const { heading, subheading } = Astro.props;
---

<header class="h-[50vh] flex items-center justify-start">
  <hgroup class="wrap @container">
    <h1 class="display">{heading}</h1>
    <p class="display highlight">{subheading}</p>
  </hgroup>
</header>
