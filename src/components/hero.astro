---
// Ours
import { type Translations } from "@/i18n";


export interface Props {
  content: Translations["hero"];
}

const { content } = Astro.props;
---

<header class="flex h-[54vh] items-center justify-start contain-strict">
  <hgroup class="@container wrap mt-7">
    <h1 class="display">{content.heading}</h1>
    <p class="highlight display">{content.subheading}</p>
  </hgroup>
</header>
