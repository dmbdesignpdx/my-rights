---
import { getEntry, render } from "astro:content";
import Hero from "@/components/hero.astro";
import Nav from "@/components/nav.astro";
import { type Language } from "@/constants/lang";
import { getTranslations } from "@/i18n";
import Group from "./group.astro";
import Footer from "./footer.astro";
import { generateLinks } from "@/lib/links";


interface Props {
  locale: Language;
}

const { locale } = Astro.props;
const entry = await getEntry("content", locale);

if (!entry) return null;

const { Content, headings } = await render(entry);
const t = getTranslations(locale);
const extraHeadings = [{ heading: t.group.heading, id: t.group.id }];
const links = generateLinks(headings, extraHeadings);
---

<Hero
  heading={t.hero.heading}
  subheading={t.hero.subheading}
/>
<Nav locale={locale} links={links} />
<main 
  class="wrap max-w-3xl prose prose-zinc dark:prose-invert prose-lg prose-p:in-prose-blockquote:before:content-none prose-figcaption:m-0 prose-blockquote:not-italic prose-blockquote:border-purple-300 dark:prose-blockquote:border-purple-800"
>
  <Content />
</main>
<Group content={t.group} />
<Footer content={t.footer} />
