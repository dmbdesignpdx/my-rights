---
// Theirs
import { getEntry, render } from "astro:content";

// Ours
import { type LanguageCode } from "@/constants/lang";
import { getTranslations } from "@/i18n";
import { generateLinks } from "@/lib/links";
import Hero from "@/components/hero.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import Resources from "@/components/resources.astro";


const locale = Astro.currentLocale as LanguageCode;
const entry = await getEntry("content", locale);

if (!entry) return null;

const { Content, headings } = await render(entry);
const t = getTranslations(locale);
const extraHeadings = [{ heading: t.resources.heading, id: t.resources.id }];
const links = generateLinks(headings, extraHeadings);
---


<Hero content={t.hero} />
<Nav links={links} />
<main
  class="
    wrap prose prose-lg max-w-3xl prose-zinc
    dark:prose-invert
    prose-h2:last-of-type:highlight
    prose-figcaption:m-0
  "
>
  <Content />
</main>
<Resources content={t.resources} />
<Footer content={t.footer} />
