---
// Theirs
import { getEntry, render } from "astro:content";

// Ours
import { type Language } from "@/constants/lang";
import { getTranslations } from "@/i18n";
import { generateLinks } from "@/lib/links";
import Hero from "@/components/hero.astro";
import Nav from "@/components/nav.astro";
import Group from "@/components/group.astro";
import Footer from "@/components/footer.astro";


interface Props {
  locale: Language;
}

const { locale } = Astro.props;
const entry = await getEntry("content", locale);

if (!entry) return null;

const { Content, headings } = await render(entry);
const t = getTranslations(locale);
const extraHeadings = [{ heading: t.group.heading, id: t.group.id }];
const links = generateLinks(headings, extraHeadings);
---

<Hero
  heading={t.hero.heading}
  subheading={t.hero.subheading}
/>
<Nav locale={locale} links={links} />
<main
  class="
    wrap prose prose-lg max-w-3xl prose-zinc
    dark:prose-invert
    prose-h2:last-of-type:highlight
    prose-figcaption:m-0
  "
>
  <Content />
</main>
<Group content={t.group} />
<Footer content={t.footer} />
