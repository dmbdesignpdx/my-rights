---
// Ours
import { type Translations } from "@/i18n";
import Link from "@/components/link.astro";


export interface Props {
  content: Translations["footer"];
}

const { content } = Astro.props;
---


<footer
  class="
    mt-20 bg-foreground py-10 text-background
    dark:bg-sidebar dark:text-sidebar-foreground
  "
>
  <div class="wrap flex flex-col gap-3">
    <p class="mt-4">{content.copy}</p>
    <address class="flex gap-3">

      {content.links.map(link => (
        <Link href={link.href}>{link.label}</Link>
      ))}

    </address>
    <p>
      <small>{content.disclaimer}</small>
    </p>
    <p>
      {content.repo.text}
      {" "}
      <Link href={content.repo.link}>{content.repo.link}</Link>
    </p>
  </div>
</footer>
