---
// Ours
import { type Translations } from "@/i18n";
import { Card } from "@/components/card";


interface Props {
  content: Translations["resources"]["section"]["orgs"];
}

const { content } = Astro.props;
---


<section class="mt-24">
  <h3 class="text-2xl font-bold trim">
    {content.heading}
  </h3>
  <div
    class="
      mt-6 grid grid-cols-1 gap-6
      md:grid-cols-2
    "
  >

    {content.list.map(org => (
      <Card {...org} />
    ))}

  </div>
</section>
