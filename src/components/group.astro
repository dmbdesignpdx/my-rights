---
// Ours
import { type Translations } from "@/i18n";
import { Card } from "@/components/card";


interface Props {
  content: Translations["group"];
}

const { content } = Astro.props;
---

<section
  id={content.id}
  class="wrap pt-16"
>
  <h3 class="highlight text-3xl font-bold">
    {content.heading}
  </h3>
  <div class="
    mt-4 grid grid-cols-1 gap-6
    md:grid-cols-2
  ">

    {content.orgs.map(org => (
      <Card
        heading={org.heading}
        copy={org.copy}
        link={org.link}
        label={org.label}
      />
    ))}

  </div>
</section>
