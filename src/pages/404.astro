---
// Ours
import { DEFAULT_CODE } from "@/constants/lang";
import Error from "@/layouts/error.astro";
import { getTranslations } from "@/i18n";


const t = getTranslations(DEFAULT_CODE);
---


<Error locale={DEFAULT_CODE} title={t.notFound.heading}>
  <h1>{t.notFound.heading}</h1>
  <p>{t.notFound.copy}</p>
  <a href="/">{t.notFound.label}</a>
</Error>
