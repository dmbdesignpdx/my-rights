---
// Theirs
import { getRelativeLocaleUrl } from "astro:i18n";

// Ours
import { type LanguageCode, ALT_LANGUAGES } from "@/constants/lang";
import { getTranslations } from "@/i18n";
import Error from "@/layouts/error.astro";


export function getStaticPaths() {
  return ALT_LANGUAGES.map((lang) => ({ params: { locale: lang } }));
}

const locale = Astro.params.locale as LanguageCode;
const t = getTranslations(locale);
const path = getRelativeLocaleUrl(locale, "/");
---


<Error title={t.notFound.heading}>
  <h1>{t.notFound.heading}</h1>
  <p>{t.notFound.copy}</p>
  <a href={path}>{t.notFound.label}</a>
</Error>
