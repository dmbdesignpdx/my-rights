---
// Theirs
import { getRelativeLocaleUrl } from "astro:i18n";

// Ours
import { type Language, STATIC_PATHS } from "@/constants/lang";
import { getTranslations } from "@/i18n";
import Error from "@/layouts/error.astro";


export function getStaticPaths() {
  return STATIC_PATHS;
}

const locale = Astro.params.locale as Language;
const t = getTranslations(locale);
const path = getRelativeLocaleUrl(locale, "/");
---


<Error locale={locale} title={t.notFound.heading}>
  <h1>{t.notFound.heading}</h1>
  <p>{t.notFound.copy}</p>
  <a href={path}>{t.notFound.label}</a>
</Error>
